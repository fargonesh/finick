        let mut loaded = use_state(|| false);
        if !*loaded.read() {
            loaded.set(true);
            let mut d_state = displays.clone();
            let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
            std::thread::spawn(move || {
                let _ = tx.send(HyprlandBackend.get_displays());
            });
            freya::prelude::spawn(async move {
                if let Some(info) = rx.recv().await {
                    d_state.set(info);
                }
            });
        }
        rect().child(page_header("Displays", "Connected monitors and resolutions.")).child(
            rect()
                .margin((0., 0., 24., 0.))
                .padding(24.)
                .corner_radius(12.)
                .background(t.bg_card)
                .border(Border::new().width(1.).fill(t.border_card))
                .children(displays.read().iter().map(|d| {
                    rect()
                        .margin((0., 0., 16., 0.))
                        .padding(16.)
                        .background(t.bg_base)
                        .corner_radius(8.)
                        .border(Border::new().width(1.).fill(t.border_subtle))
